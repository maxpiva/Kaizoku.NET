<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>207bc8ca-9eb1-41a0-9fc0-6ef80b6fb958</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <!-- Workstation GC: measured 409MB parent working set vs 3.7GB (and growing) under
         server GC after discovery sweeps, with no sweep-throughput regression. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
	<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
	<RuntimeIdentifiers>linux-arm64;linux-x64;win-x64;win-arm64;osx-arm64;</RuntimeIdentifiers>
	<RestoreSources>$(RestoreSources);$(ProjectDir)../packages;https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>
	<PropertyGroup Condition="!$(DefineConstants.Contains('ImageMagick'))">
		<!-- Temporary read Unofficial.Experimental.NetVips.Native packages from directory instead nuget.org -->
		<!-- Resolve the local package source relative to this project so it works whether built via
		     the solution ($(SolutionDir)) or the project directly (CI runs `dotnet publish` on the csproj,
		     where $(SolutionDir) is undefined). The packages/ folder lives at the repo root. -->
		<RestoreSources>$(RestoreSources);$(MSBuildThisFileDirectory)../packages;https://api.nuget.org/v3/index.json</RestoreSources>
   </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Migration\NewFolder\**" />
    <Compile Remove="scripts\**" />
    <Compile Remove="Services\Suwayomi\**" />
    <Content Remove="Migration\NewFolder\**" />
    <Content Remove="scripts\**" />
    <Content Remove="Services\Suwayomi\**" />
    <EmbeddedResource Remove="Migration\NewFolder\**" />
    <EmbeddedResource Remove="scripts\**" />
    <EmbeddedResource Remove="Services\Suwayomi\**" />
    <None Remove="Migration\NewFolder\**" />
    <None Remove="scripts\**" />
    <None Remove="Services\Suwayomi\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Services\Bridge\BridgeExtensionDescriptor.cs" />
    <Compile Remove="Services\Bridge\BridgeKeyUtility.cs" />
    <Compile Remove="Services\Bridge\BridgeMetadataBackfillService.cs" />
    <Compile Remove="Services\Bridge\BridgeSourceContext.cs" />
    <Compile Remove="Services\Bridge\ExtensionsBridgeService.cs" />
    <Compile Remove="Services\Helpers\ContextProvider.cs" />
    <Compile Remove="Services\Helpers\EtagCacheService.cs" />
    <Compile Remove="Services\Providers\ProviderQueryService.cs" />
    <Compile Remove="Services\Providers\ProviderResourceService.cs" />
    <Compile Remove="Services\Series\SeriesThumbnailService.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="appsettings.json" />
  </ItemGroup>


  <ItemGroup>
    <None Remove="Resources\na.jpg" />
    <None Remove="wwwroot.sha256" />
    <None Remove="wwwroot.zip" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" />
